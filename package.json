{
  "name": "pred-matcher",
  "version": "0.15.0",
  "private": true,
  "description": "Durable live prediction-market matcher with cohort canary enforcement, production rollout evidence, automatic semantic veto promotion, circuit breaking, shadow A/B evaluation, historical capture, calibration, regression gates, quality evaluation, settlement feedback, and replay for Polymarket and Kalshi.",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "quality:sweep": "tsx src/cli/quality-sweep.ts",
    "quality:gate": "tsx src/cli/quality-gate.ts",
    "shadow:backfill": "tsx src/cli/shadow-backfill.ts",
    "shadow:promotion": "tsx src/cli/shadow-promotion.ts",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "@types/ws": "8.18.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
